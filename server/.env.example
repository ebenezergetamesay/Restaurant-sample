# Server environment variables
# Copy this file to server/.env and fill in the values
# NEVER commit server/.env to version control

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Telegram Chat ID (numeric ID where orders should be sent)
# To find: start your bot in Telegram, then use @userinfobot or similar to get the chat ID
TELEGRAM_CHAT_ID=your-chat-id-here

# Admin API key (long random string for protecting admin endpoints)
# Use this to authenticate requests to /api/admin/* endpoints
# Example: openssl rand -base64 32
ADMIN_API_KEY=your-random-admin-key-here

# Port (optional, defaults to 3001)
# In production, set to the port your hosting platform provides via PORT env var
PORT=3001

# Order data directory (optional, defaults to server/data/)
# ORDER_DATA_DIR=/var/lib/barch-orders
